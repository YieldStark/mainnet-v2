# Target database (Supabase). From the dashboard: Connect -> Session pooler.
# The session pooler is IPv4-compatible and uses port 5432; the direct host is IPv6-only on Free.
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_PASSWORD=your-password
DB_NAME=postgres
DB_SSL=true

# One-off migration only: the old RDS database to copy from (npm run db:copy-from-source).
# Remove these once the copy is done.
SOURCE_DB_HOST=your-db-host.rds.amazonaws.com
SOURCE_DB_PORT=5432
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=your-password
SOURCE_DB_NAME=postgres
SOURCE_DB_SSL=true

# Layerswap non-custodial bridge (into/out of Starknet)
# API keys from https://layerswap.io/dashboard (quote testnet keys if they contain + or /)
VITE_LAYERSWAP_API_KEY_MAINNET=
VITE_LAYERSWAP_API_KEY_TESTNET=
# Required for the Layerswap widget's EVM/Starknet wallet connectors
# Get a project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=
