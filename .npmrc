# The Layerswap wallet stack pins exact peer versions (e.g.
# @layerswap/wallet-evm -> @tanstack/react-query@5.90.11) that conflict with the
# newer versions this app and @starknet-react/core, wagmi, etc. depend on.
# These are compatible in practice, so accept them instead of failing installs
# (matches the local install and lets CI/Vercel `npm install` succeed).
legacy-peer-deps=true
